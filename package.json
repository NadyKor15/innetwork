{
  "name": "innetwork-alexa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "InNetwork: an Alexa+ add-on (MCP 2025-11-25 + 2026-07-28, Streamable HTTP) that finds a doctor for each person in a family inside their own plan's network, sets aside the ones who can't see them, and books around the family routine",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.ts",
    "server": "node server/server.ts",
    "host": "node host/serve.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "verify": "node verify/run.ts",
    "directory:warm": "node scripts/directory-warm.ts",
    "guard:names": "node scripts/guard-names.ts",
    "audit:directories": "node packages/plannet-directory-check/bin/audit-directories.ts",
    "audit:sites": "node scripts/audit-sites.ts",
    "record": "node scripts/record-demo.ts",
    "rough-cut": "node scripts/rough-cut.ts",
    "mutations": "node verify/mutations.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
